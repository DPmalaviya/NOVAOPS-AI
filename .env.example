# Set only in deployment platform secrets or local .dev.vars. Never commit real keys.
# Gemini primary generation provider; public/synthetic demo data only on its free tier.
GEMINI_API_KEY=
# Optional Cloudflare Workers AI model binding is configured in wrangler.toml after account verification.
# Optional Ollama Cloud token. Leave blank to disable the provider.
OLLAMA_API_KEY=
# Optional public GitHub token with the least privileges needed for configured repository sync.
GITHUB_TOKEN=
# Public runtime limits, enforced again server-side in a later stage.
MAX_UPLOAD_BYTES=5242880
MAX_FILES_PER_SESSION=5
MAX_QUERY_CHARS=2000
MAX_TOP_K=8
