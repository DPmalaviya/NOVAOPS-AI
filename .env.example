# NovaOps AI — copy to .env for local runs. Never commit real values.
# Generation providers (all optional; retrieval-only fallback works with none)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
WORKERS_AI_MODEL=@cf/meta/llama-3.1-8b-instruct-fp8-fast
OLLAMA_API_KEY=
OLLAMA_MODEL=nemotron-3-nano
OLLAMA_BASE_URL=https://ollama.com
# Embeddings: local (bge-small, offline) | workers-ai (bge-base) | gemini
EMBEDDER=local
EMBEDDING_MODEL=
# Optional: raises GitHub API rate limit for sync
GITHUB_TOKEN=
# App limits
MAX_FILE_BYTES=10485760
MAX_FILES_PER_SESSION=5
MAX_QUERY_CHARS=2000
MAX_TOP_K=10
PORT=8787
